ENVIRONMENT=development


DATABASE_URL=postgresql+psycopg2://biletflow:biletflow@localhost:5432/biletflow

SECRET_KEY=change-me-to-a-long-random-value

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=BiletFlow <no-reply@biletflow.local>

ACTIVATION_FEE_KZT=5000
PROCESSING_FEE_PERCENT=3.0
ORDER_HOLD_MINUTES=10
DEFAULT_TIMEZONE=Asia/Almaty

MEDIA_DIR=media
MAX_UPLOAD_MB=5
